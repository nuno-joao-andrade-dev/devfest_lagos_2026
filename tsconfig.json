{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "step-01-basic-prompt/**/*",
    "step-02-vector-rag/**/*",
    "step-03-custom-tools/**/*",
    "step-04-agentic-rag/**/*",
    "step-05-production-agent/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
