# ============================================================================
# DevFest Lagos 2026 Workshop: Crafting a Lagos Tourism Agent with Gemma & Genkit
# ============================================================================

# Local Ollama Server URL
OLLAMA_SERVER_ADDRESS=http://127.0.0.1:11434

# Local Gemma Model in Ollama
# Default: gemma4:e2b (Gemma 4 E2B — ultra-fast on workshop laptops with native tool calling)
# Stronger laptops: gemma4:e4b
# Custom tool-enabled Modelfile alias: gemma4-lagos
GEMMA_MODEL=gemma4:e2b

# Local Embedding Model in Ollama (for Vector RAG)
EMBEDDING_MODEL=nomic-embed-text

# Weather & Marine Tool Mode:
# - "live"          : Queries real-time Open-Meteo Weather & Marine APIs for Ponta da Piedade (with automatic offline fallback)
# - "calm"          : Simulates a calm, sunny Algarve morning (ideal for sea cave kayaking)
# - "nortada_windy" : Simulates strong afternoon Nortada gusts (unsafe for kayaking; triggers land alternatives)
# - "atlantic_swell": Simulates heavy 2.4m Atlantic winter swell (Capitania closes sea caves)
WEATHER_MODE=live

# Which flow set to register in Genkit Developer UI ("both" | "exercises" | "solutions")
WORKSHOP_MODE=both
